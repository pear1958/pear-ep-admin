{
  "name": "pear-monorepo",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm -F @pear/web-admin run dev",
    "serve": "pnpm -F @pear/web-admin run dev",
    "build:dev": "pnpm -F @pear/web-admin run build:dev",
    "build:pro": "pnpm -F @pear/web-admin run build:pro",
    "prepare": "husky install",
    "lint:lint-staged": "lint-staged",
    "cz": "czg",
    "commit": "git add -A && czg"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "czg": "^1.8.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1"
  }
}
